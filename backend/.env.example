# AEGIS Intelligence Backend Configuration
NODE_ENV=development
PORT=3000

# SerpAPI Key (Required for web search)
SERP_API_KEY=your_serpapi_key_here

# AI Provider Keys (At least one required for AI analysis)
# OpenRouter - Free tier available (recommended): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Groq - Fast inference, free tier: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Mistral AI: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_key_here

# CORS Origins (comma-separated)
# For development, use: http://localhost:3000,http://localhost:56540
# For production, use your actual domain: https://yourapp.com
ALLOWED_ORIGINS=*

# Rate Limiting (requests per minute)
RATE_LIMIT_GENERAL=60
RATE_LIMIT_SEARCH=20
